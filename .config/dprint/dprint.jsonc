{
  "indentWidth": 2,
  "useTabs": false,
  "lineWidth": 100,
  // "followSymlinks": true, // custom dprint
  "typescript": {
    "functionExpression.flatIife": true,
    "preferHanging": true,
    "quoteProps": "asNeeded",
    "quoteStyle": "preferSingle",
    "semiColons": "asi",
    "trailingCommas": "never"
  },
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {},
  "toml": {},
  "dockerfile": {},
  "malva": {},
  "markup": {
    "scriptIndent": true
  },
  "yaml": {
    "quotes": "preferSingle"
  },
  "shebangs": {
    "#!/bin/sh": "sh",
    "#!/usr/bin/env bash": "sh",
    "#!/usr/bin/env node": "js",
    "#!/usr/bin/env deno run": "ts",
    "#!/usr/bin/env -S deno run": "ts"
  },
  "go-shfmt": {
    "associations": [
      "**/*.bash",
      "**/*.zsh",
      "**/.bash_login",
      "**/.bash_logout",
      "**/.bash_profile",
      "**/.bashrc",
      "**/.profile",
      "**/.zlogin",
      "**/.zlogout",
      "**/.zprofile",
      "**/.zshenv",
      "**/.zshrc"
    ]
  },
  "excludes": [
    ".cargo_home",
    ".git",
    "**/.DS_Store",
    "**/.svelte-kit",
    "**/*-lock.yaml",
    "**/*-lock.json",
    "**/build",
    "**/node_modules",
    "**/package",
    "**/vendor",
    "**/yaml.lock",
    "gh-pages",
    "target"
  ],
  "plugins": [
    "https://github.com/mridang/dprint-go/releases/download/v1.4.0/gofmt.wasm",
    "https://github.com/mridang/dprint-go/releases/download/v1.4.0/shfmt.wasm",
    "npm:@dprint/dockerfile@0.6.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/typescript@0.96.1"
  ]
}
