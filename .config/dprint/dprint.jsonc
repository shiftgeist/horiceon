{
  "indentWidth": 2,
  "useTabs": false,
  "lineWidth": 100,
  // "followSymlinks": true, // custom dprint
  "typescript": {
    "functionExpression.flatIife": true,
    "preferHanging": true,
    "quoteProps": "asNeeded",
    "quoteStyle": "preferSingle",
    "semiColons": "asi",
    "trailingCommas": "never"
  },
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {},
  "toml": {},
  "dockerfile": {},
  "malva": {},
  "markup": {
    "scriptIndent": true
  },
  "yaml": {
    "quotes": "preferSingle"
  },
  "shebangs": {
    "#!/bin/sh": "sh",
    "#!/usr/bin/env -S bun": "ts",
    "#!/usr/bin/env -S node": "ts",
    "#!/usr/bin/env -S uv run": "py",
    "#!/usr/bin/env bash": "bash",
    "#!/usr/bin/env bun": "ts",
    "#!/usr/bin/env node": "ts",
    "#!/usr/bin/env zsh": "zsh"
  },
  "shfmt": {
    "useTabs": true,
    "indentWidth": 2,
    "binaryNextLine": false,
    "switchCaseIndent": true,
    "spaceRedirects": false,
    "functionNextLine": false,
    "simplify": true,
    "minify": false
  },
  "gofumpt": {
  },
  "excludes": [
    ".cargo_home",
    ".git",
    "**/.DS_Store",
    "**/.svelte-kit",
    "**/*-lock.yaml",
    "**/*-lock.json",
    "**/build",
    "**/node_modules",
    "**/package",
    "**/vendor",
    "**/yaml.lock",
    "gh-pages",
    "target"
  ],
  "plugins": [
    "npm:@dprint/dockerfile@0.7.0",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.0",
    "npm:@dprint/shfmt@0.1.2",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/typescript@0.96.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
