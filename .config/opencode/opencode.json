  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "low"
          }
        },
        "gpt-6-luna": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-6-sol": {
          "options": {
            "reasoningEffort": "low"
          }
        },
        "gpt-6.1-sol": {
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    },
    "headroom": {
      "models": {
        "gpt-4.1": {
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "name": "GPT-4.1"
        },
        "gpt-4o": {
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "name": "GPT-4o"
        }
      },
      "name": "Headroom Proxy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8788/v1"
      }
    }
  },
  "share": "disabled",
  "small_model": "github-copilot/gpt-6-luna"
