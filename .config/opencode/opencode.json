{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "commit": {
      "model": "github-copilot/gpt-6-luna",
      "permissions": [
        {
          "action": "*",
          "effect": "deny",
          "resource": "*"
        }
      ]
    },
    "compaction": {
      "model": "github-copilot/gpt-6-luna"
    },
    "summary": {
      "model": "github-copilot/gpt-6-luna"
    },
    "title": {
      "model": "github-copilot/gpt-6-luna"
    },
    "yolo": {
      "description": "Executes fix tasks with full permissions. Delegate implementation work here.",
      "mode": "all",
      "permissions": [
        {
          "action": "*",
          "effect": "allow",
          "resource": "*"
        }
      ],
      "system": "You are the implementation agent. You have full permissions.\n- Make the smallest change that fixes the task you were given.\n- Change only what the task requires. Do not refactor unrelated code.\n- Run the verification command you were given before reporting back.\n- Report: files changed, the command you ran, and its exact result."
    }
  },
  "compaction": {
    "auto": true
  },
  "mcp": {
    "servers": {
      "context7": {
        "command": [
          "sh",
          "-c",
          "set -a; . ~/.horiceon/.env; exec pnpm dlx @upstash/context7-mcp --api-key=$CONTEXT7_API_KEY"
        ],
        "type": "local"
      },
      "headroom": {
        "command": [
          "sh",
          "-c",
          "$HOME/.local/bin/headroom mcp serve"
        ],
        "type": "local"
      },
      "markitdown": {
        "command": [
          "markitdown-mcp"
        ],
        "type": "local"
      },
      "serena": {
        "command": [
          "uvx",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "ide",
          "--open-web-dashboard",
          "False"
        ],
        "type": "local"
      }
    }
  },
