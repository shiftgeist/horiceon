#!/usr/bin/env bash

result_file=$(mktemp)
trap 'rm -f "$result_file"' EXIT

networkQuality -c "$@" > "$result_file" &
networkquality_pid=$!

seconds_elapsed=0
while kill -0 "$networkquality_pid" 2>/dev/null; do
  printf "\rRunning networkQuality... %ss" "$seconds_elapsed" >&2
  sleep 1
  seconds_elapsed=$((seconds_elapsed + 1))
done
printf "\r\033[K" >&2

responsiveness_rpm=$(yq -p=json -oy '.responsiveness' "$result_file")

responsiveness_is_missing=$(awk -v rpm="$responsiveness_rpm" 'BEGIN {print (rpm + 0 > 0) ? "no" : "yes"}')
if [ "$responsiveness_is_missing" = yes ]; then
  echo "No responsiveness result, the test ended too early. Use a longer -M (10 worked)." >&2
  exit 1
fi

uplink_bits_per_second=$(yq -p=json -oy '.ul_throughput' "$result_file")
downlink_bits_per_second=$(yq -p=json -oy '.dl_throughput' "$result_file")
idle_latency_ms=$(yq -p=json -oy '.base_rtt' "$result_file")
idle_samples_ms=$(yq -p=json -oy '.il_h2_req_resp[]' "$result_file")

jitter_ms=$(echo "$idle_samples_ms" | awk '
  NR > 1 {sum += ($1 > previous ? $1 - previous : previous - $1)}
  {previous = $1}
  END {if (NR > 1) print sum / (NR - 1); else print "n/a"}')

responsiveness_rating=$(awk -v rpm="$responsiveness_rpm" 'BEGIN {print (rpm >= 1000 ? "High" : rpm >= 200 ? "Medium" : "Low")}')

awk \
  -v uplink="$uplink_bits_per_second" \
  -v downlink="$downlink_bits_per_second" \
  -v rating="$responsiveness_rating" \
  -v responsiveness_rpm="$responsiveness_rpm" \
  -v idle_latency_ms="$idle_latency_ms" \
  -v jitter_ms="$jitter_ms" \
  'BEGIN {
    loaded_latency_ms = 60000 / responsiveness_rpm
    jitter_text = (jitter_ms == "n/a") ? "n/a" : sprintf("%.0f milliseconds", jitter_ms)

    printf "Uplink capacity: %.3f Mbps\n", uplink / 1e6
    printf "Downlink capacity: %.3f Mbps\n", downlink / 1e6
    printf "Responsiveness: %s (%.3f seconds | %.0f RPM)\n", rating, 60 / responsiveness_rpm, responsiveness_rpm
    printf "Idle Latency: %.3f milliseconds | %.0f RPM\n", idle_latency_ms, 60000 / idle_latency_ms
    printf "Latency: %.0f milliseconds | %.0f RPM\n", loaded_latency_ms, responsiveness_rpm
    printf "Jitter: %s\n", jitter_text
  }'
