{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": false,
  "compaction": {
    "auto": true
  },
  "mcp": {
    "context7": {
      "command": [
        "pnpm",
        "dlx",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "headroom": {
      "command": [
        "/Users/felix/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "environment": {
        "HEADROOM_PROXY_URL": "http://127.0.0.1:8788"
      },
      "type": "local"
    },
    "markitdown": {
      "command": [
        "markitdown-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "serena": {
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "github-copilot/gpt-6-sol",
  "permission": {
