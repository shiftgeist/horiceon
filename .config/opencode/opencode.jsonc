{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": false,
  "compaction": {
    "auto": true
  },
  "permission": {
    "bash": {
      "*": "ask",
      "awk *": "allow",
      "basename *": "allow",
      "cargo --list": "allow",
      "cargo info *": "allow",
      "cargo locate-project *": "allow",
      "cargo metadata *": "allow",
      "cargo outdated *": "allow",
      "cargo pkgid *": "allow",
      "cargo read-manifest *": "allow",
      "cargo search *": "allow",
      "cargo tree *": "allow",
      "cargo verify-project *": "allow",
      "cargo version": "allow",
      "cat": "deny", // Incident: `cat > /var/folders/21/wxz9mkn96m7_pqx626f2r8p00000gn/T/opencode/mem-draft.txt << [...]`
      "cd *": "allow",
      "chmod *": "deny",
      "column *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "deno --version": "allow",
      "deno check *": "allow",
      "deno doc *": "allow",
      "deno fmt --check *": "allow",
      "deno fmt *": "allow",
      "deno info *": "allow",
      "deno lint *": "allow",
      "deno task --list": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "doas *": "deny",
      "du *": "allow",
      "echo *": "allow",
      "env": "deny",
      "eval *": "deny",
      "false": "allow",
      "file *": "allow",
      "fd *": "ask", // keep! same as `find *`
      "find *": "ask", // keep! `-delete`, `-exec` too risky
      "find * -delete": "deny",
      "find * -exec *": "deny",
      "git blame *": "allow",
      "git branch --show-current": "allow",
      "git branch -a --list *": "allow",
      "git cat-file *": "allow",
      "git commit *": "deny",
      "git describe *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git push *": "deny",
      "git remote -v": "allow",
      "git rev-parse --abbrev-ref *": "allow",
      "git show *": "allow",
      "git stash list": "allow",
      "git stash show *": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git status *": "allow",
      "git tag --list *": "allow",
      "git tag -l *": "allow",
      "go build -n *": "allow",
      "go build *": "allow",
      "go doc *": "allow",
      "go env *": "allow",
      "go list -m -versions *": "allow",
      "go list *": "allow",
      "go mod download *": "allow",
      "go mod edit -print *": "allow",
      "go mod graph *": "allow",
      "go mod tidy *": "allow",
      "go mod verify *": "allow",
      "go mod why *": "allow",
      "go version": "allow",
      "go vet *": "allow",
      "gofmt *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "hexdump *": "allow",
      "jq *": "allow",
      "kill *": "deny",
      "less *": "allow",
      "ls *": "allow",
      "md5sum *": "allow",
      "mise --version": "allow",
      "mise -v": "allow",
      "mise config *": "allow",
      "mise doctor *": "allow",
      "mise env *": "allow",
      "mise exec *": "deny",
      "mise info *": "allow",
      "mise latest *": "allow",
      "mise list *": "allow",
      "mise ls *": "allow",
      "mise outdated *": "allow",
      "mise r *": "allow",
      "mise registry *": "allow",
      "mise tasks *": "allow",
      "mise where *": "allow",
      "mise which *": "allow",
      "mkdir *": "allow",
      "mkfs.*": "deny",
      "more *": "allow",
      "nc *": "deny",
      "node --version": "allow",
      "node -v": "allow",
      "node *": "deny",
      "openspec *": "allow",
      "perl *": "deny",
      "pnpm --version": "allow",
      "pnpm -v": "allow",
      "pnpm *": "deny",
      "pnpm audit": "allow",
      "pnpm bin-paths *": "allow",
      "pnpm doctor *": "allow",
      "pnpm fmt *": "allow",
      "pnpm info *": "allow",
      "pnpm licenses *": "allow",
      "pnpm list *": "allow",
      "pnpm ls *": "allow",
      "pnpm outdated *": "allow",
      "pnpm pack --dry-run *": "allow",
      "pnpm root *": "allow",
      "pnpm run build": "allow",
      "pnpm run test": "allow",
      "pnpm search *": "allow",
      "pnpm show *": "allow",
      "pnpm store path *": "allow",
      "pnpm view *": "allow",
      "pnpm why *": "allow",
      "printenv *": "deny",
      "ps aux": "deny", // use pgrep -af
      "pwd": "allow",
      "python -c *": "deny",
      "python3 -c *": "deny",
      "readlink *": "allow",
      "rg *": "allow",
      "rga *": "allow",
      "rm *": "deny",
      "sed --in-place *": "deny",
      "sed -i *": "deny",
      "sed *": "allow",
      "sha256sum *": "allow",
      "shred *": "deny",
      "sort *": "allow",
      "stat *": "allow",
      "strings *": "allow",
      "su *": "deny",
      "sudo *": "deny",
      "tail *": "allow",
      "timeout *": "allow",
      "tr *": "allow",
      "tre *": "allow",
      "tree *": "allow",
      "true": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "xxd *": "allow",
      "yq *": "allow"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/opencode/AGENTS.md": "allow",
      "~/.vscode/extensions/*": "allow",
      "~/openspec/*": "allow"
    },
    "read": {
      "*": "allow",
      "*/.aws/credentials": "deny",
      "*/.config/gcloud": "deny"
    },
    "websearch": "allow"
  },
  "plugin": [
    "@dietrichgebert/ponytail@latest",
    "opencode-agent-memory@latest"
  ],
  "provider": {
    "openai": {
      "models": {
        "claude-sonnet-5": {
          "options": {
            "reasoningEffort": "max"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "low"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "limit": {
              "context": 272000,
              "output": 12000
            },
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "share": "disabled",
  "small_model": "github-copilot/claude-haiku-4.5"
}
