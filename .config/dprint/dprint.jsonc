{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "dockerfile": {},
  "excludes": [
    ".cargo_home",
    ".git",
    "**/.DS_Store",
    "**/.svelte-kit",
    "**/*-lock.yaml",
    "**/*-lock.json",
    "**/build",
    "**/node_modules",
    "**/package",
    "**/vendor",
    "**/yaml.lock",
    "gh-pages",
    "target"
  ],
  "gofumpt": {},
  "indentWidth": 2,
  "json": {
    "lineWidth": 100,
    "trailingCommas": "never"
  },
  "lineWidth": 100,
  "malva": {},
  "markdown": {},
  "markup": {
    "scriptIndent": true
  },
  "plugins": [
    "npm:@dprint/dockerfile@0.8.0",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/shfmt@0.2.0",
    "npm:@dprint/toml@0.10.0",
    "npm:@dprint/typescript@0.99.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/ruff@0.12.1"
  ],
  "ruff": {
    "indentStyle": "space",
    "indentWidth": 4,
    "lineLength": 120
  },
  "shebangs": {
    "#!/bin/sh": "sh",
    "#!/usr/bin/env -S bun": "ts",
    "#!/usr/bin/env -S node": "ts",
    "#!/usr/bin/env -S uv run": "py",
    "#!/usr/bin/env bash": "bash",
    "#!/usr/bin/env bun": "ts",
    "#!/usr/bin/env node": "ts",
    "#!/usr/bin/env zsh": "bash"
  },
  "shfmt": {
    "binaryNextLine": false,
    "functionNextLine": false,
    "indentWidth": 2,
    "minify": false,
    "simplify": true,
    "spaceRedirects": false,
    "switchCaseIndent": true,
    "useTabs": true
  },
  "toml": {},
  // "followSymlinks": true, // custom dprint
  "typescript": {
    "functionExpression.flatIife": true,
    "preferHanging": true,
    "quoteProps": "asNeeded",
    "quoteStyle": "preferSingle",
    "trailingCommas": "never",
    "semicolons": "asi"
  },
  "useTabs": false,
  "yaml": {
    "quotes": "preferSingle"
  }
}
