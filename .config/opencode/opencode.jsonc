{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": false,
  "compaction": {
    "auto": true
  },
  "permission": {
    "bash": {
      "*": "ask",
      "awk *": "allow",
      "basename *": "allow",
      "bash *": "deny",
      "builtin *": "deny",
      "cargo --list": "allow",
      "cargo info *": "allow",
      "cargo locate-project *": "allow",
      "cargo metadata *": "allow",
      "cargo outdated *": "allow",
      "cargo pkgid *": "allow",
      "cargo read-manifest *": "allow",
      "cargo search *": "allow",
      "cargo tree *": "allow",
      "cargo verify-project *": "allow",
      "cargo version": "allow",
      "cat": "deny", // Incident: `cat > /var/....txt << [...]`
      "cd *": "allow",
      "chgrp *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "column *": "allow",
      "comm *": "allow",
      "command *": "deny",
      "cp *": "deny",
      "crontab *": "deny",
      "curl *": "deny",
      "cut *": "allow",
      "date *": "allow",
      "dd *": "deny",
      "deno --version": "allow",
      "deno check *": "allow",
      "deno doc *": "allow",
      "deno fmt --check *": "allow",
      "deno fmt *": "allow",
      "deno info *": "allow",
      "deno lint *": "allow",
      "deno task --list": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "doas *": "deny",
      "docker *": "deny",
      "du *": "allow",
      "echo *": "allow",
      "env": "deny",
      "env *": "deny",
      "eval *": "deny",
      "false": "allow",
      "fd *": "allow",
      "fd * --delete": "deny",
      "fd * --exec *": "deny",
      "fd * --exec-batch *": "deny",
      "fd * -x *": "deny",
      "fd * -X *": "deny",
      "file *": "allow",
      "find *": "allow",
      "find * -delete": "deny",
      "find * -exec *": "deny",
      "find * -execdir *": "deny",
      "fish *": "deny",
      "ftp *": "deny",
      "git blame *": "allow",
      "git branch --show-current": "allow",
      "git branch -a --list *": "allow",
      "git cat-file *": "allow",
      "git checkout *": "deny",
      "git cherry-pick *": "deny",
      "git clean *": "deny",
      "git commit *": "deny",
      "git describe *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git merge *": "deny",
      "git push *": "deny",
      "git rebase *": "deny",
      "git remote -v": "allow",
      "git reset *": "deny",
      "git restore *": "deny",
      "git rev-parse --abbrev-ref *": "allow",
      "git show *": "allow",
      "git stash *": "deny",
      "git stash list": "allow",
      "git stash show *": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git status *": "allow",
      "git switch *": "deny",
      "git tag --list *": "allow",
      "git tag -l *": "allow",
      "go build -n *": "allow",
      "go build *": "allow",
      "go doc *": "allow",
      "go env *": "allow",
      "go list -m -versions *": "allow",
      "go list *": "allow",
      "go mod download *": "allow",
      "go mod edit -print *": "allow",
      "go mod graph *": "allow",
      "go mod tidy *": "allow",
      "go mod verify *": "allow",
      "go mod why *": "allow",
      "go version": "allow",
      "go vet *": "allow",
      "gofmt *": "allow",
      "grep *": "allow",
      "halt *": "deny",
      "head *": "allow",
      "hexdump *": "allow",
      "install *": "deny",
      "jq *": "allow",
      "kill *": "deny",
      "killall *": "deny",
      "launchctl *": "deny",
      "less *": "allow",
      "ln *": "deny",
      "ls *": "allow",
      "md5sum *": "allow",
      "mise --version": "allow",
      "mise -v": "allow",
      "mise config *": "allow",
      "mise doctor *": "allow",
      "mise env *": "allow",
      "mise exec *": "deny",
      "mise info *": "allow",
      "mise latest *": "allow",
      "mise list *": "allow",
      "mise ls *": "allow",
      "mise outdated *": "allow",
      "mise r *": "allow",
      "mise registry *": "allow",
      "mise tasks *": "allow",
      "mise where *": "allow",
      "mise which *": "allow",
      "mkdir *": "allow",
      "mkfs.*": "deny",
      "more *": "allow",
      "mount *": "deny",
      "mv *": "deny",
      "nc *": "deny",
      "netcat *": "deny",
      "node --version": "allow",
      "node -v": "allow",
      "node *": "deny",
      "openspec *": "allow",
      "perl *": "deny",
      "php *": "deny",
      "pkill *": "deny",
      "pnpm --version": "allow",
      "pnpm -v": "allow",
      "pnpm *": "deny",
      "pnpm audit": "allow",
      "pnpm bin-paths *": "allow",
      "pnpm doctor *": "allow",
      "pnpm fmt *": "allow",
      "pnpm info *": "allow",
      "pnpm licenses *": "allow",
      "pnpm list *": "allow",
      "pnpm ls *": "allow",
      "pnpm outdated *": "allow",
      "pnpm pack --dry-run *": "allow",
      "pnpm root *": "allow",
      "pnpm run build": "allow",
      "pnpm run test": "allow",
      "pnpm search *": "allow",
      "pnpm show *": "allow",
      "pnpm store path *": "allow",
      "pnpm view *": "allow",
      "pnpm why *": "allow",
      "podman *": "deny",
      "printenv *": "deny",
      "ps aux": "deny", // use pgrep -af
      "pwd": "allow",
      "python *": "deny",
      "python3 *": "deny",
      "readlink *": "allow",
      "reboot *": "deny",
      "rg *": "allow",
      "rga *": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "rsync *": "deny",
      "ruby *": "deny",
      "scp *": "deny",
      "sed --in-place *": "deny",
      "sed -i *": "deny",
      "sed *": "allow",
      "service *": "deny",
      "setfacl *": "deny",
      "setfattr *": "deny",
      "sftp *": "deny",
      "sh *": "deny",
      "sha256sum *": "allow",
      "shred *": "deny",
      "shutdown *": "deny",
      "socat *": "deny",
      "sort *": "allow",
      "ssh *": "deny",
      "stat *": "allow",
      "strings *": "allow",
      "su *": "deny",
      "sudo *": "deny",
      "systemctl *": "deny",
      "tail *": "allow",
      "tee *": "deny",
      "telnet *": "deny",
      "timeout *": "allow",
      "tr *": "allow",
      "tre *": "allow",
      "tree *": "allow",
      "true": "allow",
      "truncate *": "deny",
      "umount *": "deny",
      "uname *": "allow",
      "uniq *": "allow",
      "unlink *": "deny",
      "wc *": "allow",
      "wget *": "deny",
      "which *": "allow",
      "wipefs *": "deny",
      "xargs *": "deny",
      "xxd *": "allow",
      "yq *": "allow",
      "zsh *": "deny"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/opencode/AGENTS.md": "allow",
      "~/.vscode/extensions/*": "allow",
      "~/openspec/*": "allow"
    },
    "read": {
      "*": "allow",
      "*/.aws/credentials": "deny",
      "*/.config/gcloud": "deny"
    },
    "websearch": "allow"
  },
  "plugin": [
    "@dietrichgebert/ponytail@latest",
    "opencode-agent-memory@latest"
  ],
  "provider": {
    "openai": {
      "models": {
        "claude-sonnet-5": {
          "options": {
            "reasoningEffort": "max"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "low"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "limit": {
              "context": 272000,
              "output": 12000
            },
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "share": "disabled",
  "small_model": "github-copilot/claude-haiku-4.5"
}
